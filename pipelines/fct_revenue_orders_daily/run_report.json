        "sql": "WITH \"stg_payment\" AS MATERIALIZED (SELECT \"payment_id\", \"rental_id\", \"amount_usd\", \"payment_date\" FROM (SELECT *, row_number() OVER (PARTITION BY _key_0 ORDER BY _order DESC NULLS LAST, _ctid) AS _rank FROM (SELECT * FROM (SELECT CAST(src.\"payment_id\" AS integer) AS \"payment_id\", CAST(src.\"rental_id\" AS integer) AS \"rental_id\", CAST(src.\"amount\" AS numeric(18,2)) AS \"amount_usd\", CAST((src.\"payment_date\" AT TIME ZONE 'UTC') AS timestamp) AS \"payment_date\", src.\"payment_id\" AS _raw_0, src.\"rental_id\" AS _raw_1, src.\"amount\" AS _raw_2, src.\"payment_date\" AS _raw_3, src.\"payment_id\" AS _key_0, src.\"payment_date\" AS _order, src.ctid AS _ctid FROM \"pagila\".\"payment\" AS src) AS typed WHERE NOT ((_raw_0 IS NOT NULL AND \"payment_id\" IS NULL) OR (_raw_1 IS NOT NULL AND \"rental_id\" IS NULL) OR (_raw_2 IS NOT NULL AND \"amount_usd\" IS NULL) OR (_raw_3 IS NOT NULL AND \"payment_date\" IS NULL) OR (payment_id IS NULL) IS TRUE OR (amount_usd < 0) IS TRUE)) AS clean) AS ranked WHERE _rank = 1), \"stg_rental\" AS MATERIALIZED (SELECT \"rental_id\", \"rental_date\" FROM (SELECT *, row_number() OVER (PARTITION BY _key_0 ORDER BY _order ASC NULLS LAST, _ctid) AS _rank FROM (SELECT * FROM (SELECT CAST(src.\"rental_id\" AS integer) AS \"rental_id\", CAST((src.\"rental_date\" AT TIME ZONE 'UTC') AS timestamp) AS \"rental_date\", src.\"rental_id\" AS _raw_0, src.\"rental_date\" AS _raw_1, src.\"rental_id\" AS _key_0, src.\"rental_id\" AS _order, src.ctid AS _ctid FROM \"pagila\".\"rental\" AS src) AS typed WHERE NOT ((_raw_0 IS NOT NULL AND \"rental_id\" IS NULL) OR (_raw_1 IS NOT NULL AND \"rental_date\" IS NULL) OR (rental_id IS NULL) IS TRUE)) AS clean) AS ranked WHERE _rank = 1)\nSELECT CAST(date_trunc('day', payment.payment_date) AS date) AS \"payment_date\", SUM(payment.amount_usd) AS \"total_revenue\", COUNT(DISTINCT payment.payment_id) AS \"total_orders\"\nFROM \"stg_payment\" AS \"payment\" INNER JOIN \"stg_rental\" AS \"rental\" ON payment.rental_id = rental.rental_id\nWHERE true\nGROUP BY 1"
      }
