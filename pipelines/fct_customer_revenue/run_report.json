        "sql": "WITH \"stg_customer\" AS MATERIALIZED (SELECT \"customer_id\", \"first_name\" FROM (SELECT *, row_number() OVER (PARTITION BY _key_0 ORDER BY _order ASC NULLS LAST, _ctid) AS _rank FROM (SELECT * FROM (SELECT CAST(src.\"customer_id\" AS integer) AS \"customer_id\", CAST(src.\"first_name\" AS text) AS \"first_name\", src.\"customer_id\" AS _raw_0, src.\"first_name\" AS _raw_1, src.\"customer_id\" AS _key_0, src.\"customer_id\" AS _order, src.ctid AS _ctid FROM \"pagila\".\"customer\" AS src) AS typed WHERE NOT ((_raw_0 IS NOT NULL AND \"customer_id\" IS NULL) OR (_raw_1 IS NOT NULL AND \"first_name\" IS NULL) OR (customer_id IS NULL) IS TRUE)) AS clean) AS ranked WHERE _rank = 1), \"stg_payment\" AS MATERIALIZED (SELECT \"payment_id\", \"customer_id\", \"amount\" FROM (SELECT *, row_number() OVER (PARTITION BY _key_0 ORDER BY _order ASC NULLS LAST, _ctid) AS _rank FROM (SELECT * FROM (SELECT CAST(src.\"payment_id\" AS integer) AS \"payment_id\", CAST(src.\"customer_id\" AS integer) AS \"customer_id\", CAST(src.\"amount\" AS numeric(18,2)) AS \"amount\", src.\"payment_id\" AS _raw_0, src.\"customer_id\" AS _raw_1, src.\"amount\" AS _raw_2, src.\"payment_id\" AS _key_0, src.\"payment_id\" AS _order, src.ctid AS _ctid FROM \"pagila\".\"payment\" AS src) AS typed WHERE NOT ((_raw_0 IS NOT NULL AND \"payment_id\" IS NULL) OR (_raw_1 IS NOT NULL AND \"customer_id\" IS NULL) OR (_raw_2 IS NOT NULL AND \"amount\" IS NULL) OR (customer_id IS NULL) IS TRUE OR (amount < 0) IS TRUE)) AS clean) AS ranked WHERE _rank = 1)\nSELECT customer.customer_id AS \"customer_id\", SUM(payment.__m1) AS \"total_revenue\", COALESCE(SUM(payment.__m2), 0) AS \"order_count\"\nFROM \"stg_customer\" AS \"customer\" INNER JOIN (SELECT payment.customer_id, SUM(payment.amount) AS __m1, COUNT(payment.payment_id) AS __m2 FROM \"stg_payment\" AS payment GROUP BY payment.customer_id) AS \"payment\" ON payment.customer_id = customer.customer_id\nWHERE true\nGROUP BY 1"
      }
    }
